# ───────────────────────────────────────────────────────────────
# celesterosaBE — esempio di configurazione.
# Copia in `.env` e compila i valori reali. Il file `.env` NON va
# mai versionato (vedi .gitignore): contiene segreti.
# ───────────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=development
PORT=3000
# Origin del frontend ammessi da CORS (lista separata da virgola)
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# --- Database (MariaDB via driver mysql2) ---
# Nota: si usa dialect 'mysql' col driver mysql2, combo stabile con Sequelize 6
# contro MariaDB. Il driver nativo 'mariadb' v3 ha un bug su removeColumn.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=celesterosa
DB_PASSWORD=celesterosa
DB_NAME=celesterosa
DB_ROOT_PASSWORD=root
DB_DIALECT=mysql
# Offset numerico richiesto da mysql2 ('+02:00' estate, '+01:00' inverno).
DB_TIMEZONE=+02:00
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# --- JWT / Auth ---
JWT_SECRET=cambia-questo-secret-lungo-e-casuale
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-anche-questo-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=celesterosa
JWT_AUDIENCE=celesterosa-client
# Costo (cost factor) bcrypt per l'hash delle password
BCRYPT_ROUNDS=12
# Rate limit dedicato alle rotte auth (login/register/refresh)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- MinIO / Object storage immagini ---
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=celesterosa-images
# URL pubblico base per comporre i link alle immagini
MINIO_PUBLIC_URL=http://localhost:9000

# --- Stripe (sandbox) ---
# Chiavi di TEST dal dashboard Stripe (sk_test_... / pk_test_...).
# Vuota = pagamento simulato (nessuna chiamata a Stripe).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Segreto del webhook (whsec_...) generato da `stripe listen` o dal dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=eur

# --- Email (nodemailer, sandbox SMTP es. Mailtrap/Ethereal) ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="celesterosa <no-reply@celesterosa.it>"

# --- Fatturazione ---
INVOICE_VAT_RATE=22
INVOICE_NUMBER_PREFIX=CEL
# Dati del cedente (negozio) stampati in fattura
INVOICE_SELLER_NAME=celesterosa S.r.l.
INVOICE_SELLER_VAT=IT00000000000
INVOICE_SELLER_ADDRESS=Via della Musica 1, 00100 Roma (RM)

# --- Upload immagini (admin) ---
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=8

# --- Spedizione ---
# Tariffa fissa (IVA inclusa) e soglia per la spedizione gratuita.
SHIPPING_FLAT=9.90
SHIPPING_FREE_THRESHOLD=99

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
